{
    "version": "1.0.0",
    "manifest_version": 3,
    "name": "M-Iherb",
    "description": "The Chrome extension helps VN buyers create orders with free tax and the lowest shipping cost automatically",
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "M-Iherb extension"
    },
    "side_panel": {
        "default_path": "js/index.html"
    },
    "background": {
        "service_worker": "js/service-worker.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.iherb.com/*",
                "*://checkout9.iherb.com/*"
            ],
            "css": [
                "js/content-script.css"
            ],
            "js": [
                "js/content-script.js"
            ]
        }
    ],
    "permissions": [
        "sidePanel",
        "tabs",
        "storage",
        "alarms"
    ],
    "host_permissions": [
        "http://localhost:8000/*"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "externally_connectable": {
        "matches": [
            "http://localhost:3000/*"
        ]
    }
}